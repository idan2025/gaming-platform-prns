{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanthorn",
  "version": "0.2.31",
  "identifier": "org.idan2025.gamingplatformprns.launcher",
  "mainBinaryName": "lanthorn",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lanthorn",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRTM5NUQ0NjNBOTE3NDIKUldSQ0Y2bGoxSlhqTHNDUVJaeDduYi91SWdTc1p6RlFHV3BmQ056U2pDbWp4SkZSUnZZeXNSYjQK",
      "endpoints": [
        "https://github.com/idan2025/gaming-platform-prns/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["lanthorn"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../packs/*.toml": "packs/"
    },
    "shortDescription": "Decentralized game-server browser over Reticulum",
    "longDescription": "Find and join game servers over a Reticulum mesh with no account, no port forwarding, no central service and no internet required. The launcher browses announces directly; an index, if one exists at all, is only a cache.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" }
    }
  }
}
